<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ObbyistMacro.Controls">

    <Style TargetType="controls:ToggleSwitch">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToggleSwitch">
                    <Grid x:Name="PART_Root" Background="Transparent">
                        <Border x:Name="PART_Track" CornerRadius="12" Width="46" Height="24"
                                Background="#26332C55">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0" Color="#FF3BFF88" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="PART_Thumb" CornerRadius="9" Width="18" Height="18"
                                HorizontalAlignment="Left" Margin="3,0,0,0"
                                Background="#FF332C55">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbTranslate" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0" Color="#FF3BFF88" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>