<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Colors (inspired by the ObbyistMacro logo) ===================== -->
    <Color x:Key="BgColor">#FF141021</Color>
    <Color x:Key="BgGlowColor">#FF1D1630</Color>
    <Color x:Key="CardColor">#FF1C1529</Color>
    <Color x:Key="CardBorderColor">#FF2E2547</Color>
    <Color x:Key="AccentColor">#FF3BFF88</Color>
    <Color x:Key="AccentDimColor">#2E3BFF88</Color>
    <Color x:Key="AccentSoftColor">#1F3BFF88</Color>
    <Color x:Key="TrayYellowColor">#FFFFC93C</Color>
    <Color x:Key="TrayYellowHoverColor">#FFFFD45E</Color>
    <Color x:Key="TrayYellowPressColor">#FFE5B02B</Color>
    <Color x:Key="CloseRedColor">#FFE5484D</Color>
    <Color x:Key="CloseRedHoverColor">#FFFF5A60</Color>
    <Color x:Key="CloseRedPressColor">#FFC93A3F</Color>
    <Color x:Key="TextColor">#FFF2EDFF</Color>
    <Color x:Key="TextDimColor">#FF9D95BE</Color>
    <Color x:Key="TextFaintColor">#FF6E6791</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgGlowBrush" Color="{StaticResource BgGlowColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TrayYellowBrush" Color="{StaticResource TrayYellowColor}" />
    <SolidColorBrush x:Key="TrayYellowHoverBrush" Color="{StaticResource TrayYellowHoverColor}" />
    <SolidColorBrush x:Key="TrayYellowPressBrush" Color="{StaticResource TrayYellowPressColor}" />
    <SolidColorBrush x:Key="CloseRedBrush" Color="{StaticResource CloseRedColor}" />
    <SolidColorBrush x:Key="CloseRedHoverBrush" Color="{StaticResource CloseRedHoverColor}" />
    <SolidColorBrush x:Key="CloseRedPressBrush" Color="{StaticResource CloseRedPressColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />

    <!-- ===================== Fonts ===================== -->
    <FontFamily x:Key="TitleFont">Bahnschrift SemiBold</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- ===================== Animations ===================== -->
    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseInCubic" EasingMode="EaseIn" />
    <QuarticEase x:Key="EaseOutQuart" EasingMode="EaseOut" />
    <BounceEase x:Key="EaseOutBounce" EasingMode="EaseOut" Bounces="3" Bounciness="2" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#FF000000" />
    <DropShadowEffect x:Key="GreenGlow" BlurRadius="22" ShadowDepth="0" Opacity="0" Color="{StaticResource AccentColor}" />
    <DropShadowEffect x:Key="YellowGlow" BlurRadius="18" ShadowDepth="0" Opacity="0" Color="{StaticResource TrayYellowColor}" />
    <DropShadowEffect x:Key="RedGlow" BlurRadius="18" ShadowDepth="0" Opacity="0" Color="{StaticResource CloseRedColor}" />

    <!-- ===================== Card ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ===================== Text ===================== -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <!-- ===================== Buttons ===================== -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#FF241D3C" />
        <Setter Property="BorderBrush" Value="#FF3A2F5E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF2D2450" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#FF4A3C7C" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF191233" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="#FF07221A" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF5BFFA3" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FF2BD970" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TextBox ===================== -->
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#FF100C1C" />
        <Setter Property="BorderBrush" Value="#FF3A2F5E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDimBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#FF4A3C7C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>