<Window x:Class="ObbyistMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ObbyistMacro.Controls"
        Title="ObbyistMacro"
        Width="960" Height="700" MinWidth="880" MinHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF332C55" CornerRadius="4" Margin="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource SlimScrollBar}"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="17" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" BlurRadius="16" ShadowDepth="0"
                                                  Opacity="0" Color="#FFFFC93C" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBindButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FF100C1C" />
            <Setter Property="BorderBrush" Value="#FF3A2F5E" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" BlurRadius="12" ShadowDepth="0"
                                                  Opacity="0" Color="#FF3BFF88" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#FF221C3A" />
            <Setter Property="BorderBrush" Value="#FF3A2F5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <Style x:Key="ToastCard" TargetType="Border">
            <Setter Property="Background" Value="#FF221C3A" />
            <Setter Property="BorderBrush" Value="#FF3D3168" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <!-- Invisible resize-grip Thumb: the default WPF Thumb template
             paints a visible bordered chrome, and these Thumbs are laid
             out as a full frame around the window's edges, which was the
             actual source of the white outline. -->
        <Style x:Key="ResizeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Margin="10" CornerRadius="22" Background="{StaticResource BgBrush}"
            BorderBrush="#FF2E2547" BorderThickness="1" ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <!-- ===================== Ambient background ===================== -->
            <Canvas x:Name="AmbientLayer" IsHitTestVisible="False" ClipToBounds="True" />

            <!-- ===================== Main layout ===================== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <!-- ===================== Title bar ===================== -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Border BorderBrush="#FF241D3C" BorderThickness="0,0,0,1" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="pack://application:,,,/assets/logo_256.png" Width="26" Height="26"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect x:Name="TitleLogoGlow" BlurRadius="10" ShadowDepth="0"
                                                  Opacity="0.5" Color="#FF3BFF88" />
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="ObbyistMacro" FontFamily="{StaticResource TitleFont}" FontSize="15"
                                   Foreground="{StaticResource TextBrush}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Background="#FF241D3C" CornerRadius="999" Padding="8,2" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadge" Text="v1.0.0" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                        <Button x:Name="TrayButton" Style="{StaticResource TitleBarBtn}"
                                Background="{StaticResource TrayYellowBrush}"
                                ToolTip="Minimize to tray" Click="TrayButton_Click">
                            <TextBlock Text="&#x2212;" FontFamily="{StaticResource TitleFont}" FontSize="15"
                                       Foreground="#FF1C1300" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource TitleBarBtn}" Margin="8,0,0,0"
                                Background="{StaticResource CloseRedBrush}"
                                ToolTip="Close ObbyistMacro" Click="CloseButton_Click">
                            <TextBlock Text="&#x2715;" FontFamily="{StaticResource TitleFont}" FontSize="12"
                                       Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===================== Content ===================== -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tabs -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Grid>
                                <Border x:Name="TabIndicator" Width="150" Height="36" CornerRadius="10"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="TabIndicatorMove" X="0" />
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.35"
                                                          Color="#FF3BFF88" />
                                    </Border.Effect>
                                </Border>
                                <UniformGrid Columns="4" Width="600">
                                    <Button x:Name="TabHome" Style="{StaticResource TabButton}" Click="Tab_Click"
                                            Tag="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="TabHomeIcon" Data="M4 11 L12 4 L20 11 M6 9.5 V19 H18 V9.5"
                                                  Stroke="{StaticResource TextDimBrush}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Home" FontSize="13" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabFps" Style="{StaticResource TabButton}" Click="Tab_Click"
                                            Tag="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="TabFpsIcon" Data="M13 2 L5 13 H11 L9 22 L19 10 H13 Z"
                                                  Stroke="{StaticResource TextDimBrush}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="15" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="FPS Changer" FontSize="13" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabWallhop" Style="{StaticResource TabButton}" Click="Tab_Click"
                                            Tag="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="TabWallhopIcon" Data="M12 3 V21 M5.5 9.5 L12 3 L18.5 9.5 M5.5 14.5 L12 21 L18.5 14.5"
                                                  Stroke="{StaticResource TextDimBrush}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Wallhop" FontSize="13" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabFreeze" Style="{StaticResource TabButton}" Click="Tab_Click"
                                            Tag="3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="TabFreezeIcon" Data="M12 3 V21 M3 12 H21 M6.4 6.4 L17.6 17.6 M17.6 6.4 L6.4 17.6"
                                                  Stroke="{StaticResource TextDimBrush}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="Freeze" FontSize="13" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Pages -->
                    <Grid Grid.Row="1" Margin="18,4,18,14">

                        <!-- ===================== HOME PAGE ===================== -->
                        <Grid x:Name="PageHome" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PageHomeMove" Y="12" />
                            </Grid.RenderTransform>
                            <ScrollViewer Style="{StaticResource SlimScrollViewer}">
                                <StackPanel Margin="0,0,8,10">
                                    <!-- Hero -->
                                    <Grid Margin="0,8,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="92" Height="92" VerticalAlignment="Center">
                                            <Ellipse Width="92" Height="92" Opacity="0.35">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#FF3BFF88" Offset="0" />
                                                        <GradientStop Color="#003BFF88" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="HeroGlowScale" ScaleX="0.85" ScaleY="0.85" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Image x:Name="HeroLogo" Source="pack://application:,,,/assets/logo_256.png"
                                                   Width="64" Height="64"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Effect>
                                                    <DropShadowEffect x:Name="HeroLogoGlow" BlurRadius="26"
                                                                      ShadowDepth="0" Opacity="0" Color="#FF3BFF88" />
                                                </Image.Effect>
                                            </Image>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="ObbyistMacro" Style="{StaticResource PageTitleText}"
                                                       FontSize="28" />
                                            <TextBlock Text="Professional Roblox obbies toolkit — FPS changer, Wallhop and Freeze macros, all in one place."
                                                       Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Border Style="{StaticResource Chip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="RobloxDot" Width="8" Height="8"
                                                                 VerticalAlignment="Center">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush x:Name="RobloxDotBrush" Color="#FF3BFF88" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock x:Name="RobloxStatusText" Text="Roblox: checking..."
                                                                   FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                                                                   Foreground="{StaticResource TextDimBrush}"
                                                                   Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="FPS cap" FontSize="11.5"
                                                                   Foreground="{StaticResource TextFaintBrush}" />
                                                        <TextBlock x:Name="FpsCapChip" Text="60"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                                   Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Macros armed" FontSize="11.5"
                                                                   Foreground="{StaticResource TextFaintBrush}" />
                                                        <TextBlock x:Name="ArmedChip" Text="0/3"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                                   Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Global settings -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="GLOBAL SETTINGS" Style="{StaticResource SectionTitleText}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="Roblox Sensitivity" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBox x:Name="SensBox" Style="{StaticResource AppTextBox}"
                                                             Width="150" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                                    <TextBlock Text="Your in-game camera sensitivity. The Wallhop macro uses this to compute the exact flick distance."
                                                               Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                    <TextBlock Text="Roblox FPS Cap" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBox x:Name="FpsBox" Style="{StaticResource AppTextBox}"
                                                             Width="90" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                                    <TextBlock Text="Display only — shows the FPS cap the macros assume Roblox is at. Edit it to match your in-game cap; it never changes it in-game."
                                                               Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Start Minimized" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Launches ObbyistMacro hidden in the system tray. All macros keep working."
                                                               Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                                    <controls:ToggleSwitch x:Name="StartMinToggle"
                                                                           Margin="0,10,0,0"
                                                                           AutomationProperties.Name="Start minimized" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                    <TextBlock Text="Fast Settings" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Open the FPS, Wallhop or Freeze tab to set its hotkey, enable it and read its guide."
                                                               Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===================== FPS PAGE ===================== -->
                        <Grid x:Name="PageFps" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PageFpsMove" Y="12" />
                            </Grid.RenderTransform>
                            <ScrollViewer Style="{StaticResource SlimScrollViewer}">
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="FPS Changer" Style="{StaticResource PageTitleText}" />
                                    <TextBlock Text="Toggle your Roblox FPS cap between 60 and 240 straight from the game — no tabbing out."
                                               Style="{StaticResource BodyText}" Margin="0,6,0,14" />

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="HOW IT WORKS" Style="{StaticResource SectionTitleText}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                                                The macro drives Roblox's own settings menu with keyboard input, exactly like the classic AHK script: <Run FontFamily="Consolas" Foreground="{StaticResource AccentBrush}">Esc</Run> opens the menu, <Run FontFamily="Consolas" Foreground="{StaticResource AccentBrush}">Tab</Run> focuses it, the calibrated number of <Run FontFamily="Consolas" Foreground="{StaticResource AccentBrush}">Down</Run> presses highlights the FPS option, and <Run FontFamily="Consolas" Foreground="{StaticResource AccentBrush}">Enter</Run> selects the cap. Nothing is injected into the game — it just presses the same keys you would.
                                            </TextBlock>
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10"
                                                    BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                                                    Margin="0,12,0,0" Padding="12,9">
                                                <TextBlock Style="{StaticResource BodyText}">
                                                    <Run Foreground="{StaticResource TextBrush}">First-time setup:</Run> run a one-time Calibration so the macro knows how many Down presses highlight the FPS option in your menu. Re-calibrate whenever Roblox updates its menu.
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="CONTROLS" Style="{StaticResource SectionTitleText}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Enable macro" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Hotkey only fires while Roblox is focused."
                                                               Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                                    <controls:ToggleSwitch x:Name="FpsEnablePageToggle"
                                                                           Margin="0,10,0,0"
                                                                           AutomationProperties.Name="FPS macro page" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                                    <TextBlock Text="Hotkey" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Keyboard key or mouse button. Click the box, then press it."
                                                               Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                                    <Button x:Name="FpsKeyButton" Style="{StaticResource KeyBindButton}"
                                                            Content="F6" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                            Click="FpsKeyButton_Click" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Background="#FF241D3C" Margin="0,16,0,0" />

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="Calibration" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Style="{StaticResource HintText}" Margin="0,5,0,0">
                                                        1. Click Start Calibration — Roblox is focused automatically and a tooltip follows your cursor.
                                                        2. Press Esc to open the menu, then Tab.
                                                        3. Press Down until the FPS option is highlighted, then Enter to save — Esc cancels.
                                                    </TextBlock>
                                                    <Button x:Name="CalibrateButton" Content="Start Calibration"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                            Margin="0,10,0,0" Focusable="False"
                                                            Click="CalibrateButton_Click" />
                                                    <TextBlock x:Name="CalibrationStatus" Style="{StaticResource HintText}"
                                                               Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                    <TextBlock Text="Fine-tune counts" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Style="{StaticResource HintText}" Margin="0,5,0,0">
                                                        If the highlight misses the FPS option, adjust Menu Down. The selector always moves 10 steps toward 60 or 240.
                                                    </TextBlock>
                                                    <Grid Margin="0,12,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="Menu Down" FontSize="11"
                                                                       Foreground="{StaticResource TextFaintBrush}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <Button Content="&#x2212;" Width="26" Height="26"
                                                                        Style="{StaticResource GhostButton}" Padding="0"
                                                                        Click="StepCount_Click" Tag="fpsdown,-1" />
                                                                <TextBlock x:Name="FpsDownValue" Text="0" Width="34"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                                                           TextAlignment="Center" VerticalAlignment="Center" />
                                                                <Button Content="+" Width="26" Height="26"
                                                                        Style="{StaticResource GhostButton}" Padding="0"
                                                                        Click="StepCount_Click" Tag="fpsdown,1" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===================== WALLHOP PAGE ===================== -->
                        <Grid x:Name="PageWallhop" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PageWallhopMove" Y="12" />
                            </Grid.RenderTransform>
                            <ScrollViewer Style="{StaticResource SlimScrollViewer}">
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="Wallhop" Style="{StaticResource PageTitleText}" />
                                    <TextBlock Text="Flick and jump automatically to perform clean wallhops."
                                               Style="{StaticResource BodyText}" Margin="0,6,0,14" />

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="WHAT IT DOES" Style="{StaticResource SectionTitleText}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                                                Based on Spencer Macro Utilities' wallhop: each trigger flicks your camera sideways while holding jump, then flicks it back after 19 ms — turning a wall into a step. The flick distance is computed from your Roblox sensitivity (set on the Home tab), so it feels the same at any sens.
                                            </TextBlock>
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10"
                                                    BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                                                    Margin="0,12,0,0" Padding="12,9">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="999"
                                                            Padding="9,3">
                                                        <TextBlock Text="TIP" FontFamily="{StaticResource TitleFont}"
                                                                   FontSize="10" Foreground="#FF07221A" />
                                                    </Border>
                                                    <TextBlock Style="{StaticResource BodyText}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center">
                                                        Keep your Roblox FPS cap at <Run FontFamily="Consolas" Foreground="{StaticResource AccentBrush}">60</Run> — it's simpler and keeps the wallhop timing consistent.
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="CONTROLS" Style="{StaticResource SectionTitleText}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Enable macro" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Hotkey only fires while Roblox is focused."
                                                               Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                                    <controls:ToggleSwitch x:Name="WallhopEnablePageToggle"
                                                                           Margin="0,10,0,0"
                                                                           AutomationProperties.Name="Wallhop macro page" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                                    <TextBlock Text="Hotkey" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Keyboard key or mouse button. Click the box, then press it."
                                                               Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                                    <Button x:Name="WallhopKeyButton" Style="{StaticResource KeyBindButton}"
                                                            Content="XButton2" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                            Click="WallhopKeyButton_Click" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                                    <TextBlock Text="Jump during wallhop" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Holds Space while flicking, like Spencer Macro Utilities' default. Turn it off to flick without jumping."
                                                               Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                                    <controls:ToggleSwitch x:Name="WallhopJumpToggle" Margin="0,10,0,0"
                                                                           AutomationProperties.Name="Jump during wallhop" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Uses from Home tab:"
                                                       FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Sensitivity" FontSize="11"
                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                    <TextBlock x:Name="WallhopSensChip" Text="0.123"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                               Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Roblox FPS" FontSize="11"
                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                    <TextBlock x:Name="WallhopFpsChip" Text="60"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                               Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===================== FREEZE PAGE ===================== -->
                        <Grid x:Name="PageFreeze" Visibility="Collapsed" Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PageFreezeMove" Y="12" />
                            </Grid.RenderTransform>
                            <ScrollViewer Style="{StaticResource SlimScrollViewer}">
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="Freeze" Style="{StaticResource PageTitleText}" />
                                    <TextBlock Text="Pause the whole game instantly — stop mid-air, hold a position, buy yourself a second."
                                               Style="{StaticResource BodyText}" Margin="0,6,0,14" />

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="WHAT IT DOES" Style="{StaticResource SectionTitleText}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                                                Freeze suspends the entire Roblox process using the system's native suspend call (the same technique as the Prison Life Macro Suite) — the game freezes exactly where it is. Nothing is injected; the game just stops, then continues seamlessly when you unfreeze.
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0">
                                                <Run Foreground="{StaticResource TextBrush}">Toggle mode:</Run> press once to freeze, press again to unfreeze.
                                                <LineBreak />
                                                <Run Foreground="{StaticResource TextBrush}">Hold mode:</Run> frozen while you hold the key, unfreezes on release.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="CONTROLS" Style="{StaticResource SectionTitleText}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Enable macro" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Hotkey only fires while Roblox is focused."
                                                               Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                                    <controls:ToggleSwitch x:Name="FreezeEnablePageToggle"
                                                                           Margin="0,10,0,0"
                                                                           AutomationProperties.Name="Freeze macro page" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                                    <TextBlock Text="Hotkey" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5" />
                                                    <TextBlock Text="Keyboard key or mouse button. Click the box, then press it."
                                                               Style="{StaticResource HintText}" Margin="0,5,0,0" />
                                                    <Button x:Name="FreezeKeyButton" Style="{StaticResource KeyBindButton}"
                                                            Content="(none)" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                            Click="FreezeKeyButton_Click" />
                                                    <TextBlock Text="Mode" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                                               Margin="0,16,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Border x:Name="ToggleModeWrap" CornerRadius="9" Padding="0"
                                                                Background="#FF241D3C" BorderBrush="#FF3A2F5E"
                                                                BorderThickness="1">
                                                            <Button x:Name="ToggleModeBtn" Content="Toggle"
                                                                    Style="{StaticResource GhostButton}" Padding="18,8"
                                                                    BorderThickness="0" Click="FreezeMode_Click" Tag="Toggle" />
                                                        </Border>
                                                        <Border x:Name="HoldModeWrap" CornerRadius="9" Padding="0" Margin="8,0,0,0"
                                                                Background="#FF241D3C" BorderBrush="#FF3A2F5E"
                                                                BorderThickness="1">
                                                            <Button x:Name="HoldModeBtn" Content="Hold"
                                                                    Style="{StaticResource GhostButton}" Padding="18,8"
                                                                    BorderThickness="0" Click="FreezeMode_Click" Tag="Hold" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===================== Status bar ===================== -->
                <Border Grid.Row="2" BorderBrush="#FF241D3C" BorderThickness="0,1,0,0"
                        Background="#FF110D1D">
                    <Grid Margin="16,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusLeft" Text="Ready."
                                       FontFamily="{StaticResource BodyFont}" FontSize="11"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="ObbyistMacro v" FontSize="11"
                                       Foreground="{StaticResource TextFaintBrush}" />
                            <TextBlock x:Name="StatusVersion" Text="1.0.0" FontSize="11"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== Toasts ===================== -->
            <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,14,44">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ToastHostMove" Y="24" />
                </StackPanel.RenderTransform>
            </StackPanel>

            <!-- ===================== Resize thumbs ===================== -->
            <Grid IsHitTestVisible="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Thumb x:Name="ResizeNW" Style="{StaticResource ResizeThumb}" Grid.Row="0" Grid.Column="0" Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_Drag" Tag="NW" />
                <Thumb x:Name="ResizeN" Style="{StaticResource ResizeThumb}" Grid.Row="0" Grid.Column="1" Cursor="SizeNS"
                       DragDelta="ResizeThumb_Drag" Tag="N" />
                <Thumb x:Name="ResizeNE" Style="{StaticResource ResizeThumb}" Grid.Row="0" Grid.Column="2" Cursor="SizeNESW"
                       DragDelta="ResizeThumb_Drag" Tag="NE" />
                <Thumb x:Name="ResizeW" Style="{StaticResource ResizeThumb}" Grid.Row="1" Grid.Column="0" Cursor="SizeWE"
                       DragDelta="ResizeThumb_Drag" Tag="W" />
                <Thumb x:Name="ResizeE" Style="{StaticResource ResizeThumb}" Grid.Row="1" Grid.Column="2" Cursor="SizeWE"
                       DragDelta="ResizeThumb_Drag" Tag="E" />
                <Thumb x:Name="ResizeSW" Style="{StaticResource ResizeThumb}" Grid.Row="2" Grid.Column="0" Cursor="SizeNESW"
                       DragDelta="ResizeThumb_Drag" Tag="SW" />
                <Thumb x:Name="ResizeS" Style="{StaticResource ResizeThumb}" Grid.Row="2" Grid.Column="1" Cursor="SizeNS"
                       DragDelta="ResizeThumb_Drag" Tag="S" />
                <Thumb x:Name="ResizeSE" Style="{StaticResource ResizeThumb}" Grid.Row="2" Grid.Column="2" Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_Drag" Tag="SE" />
            </Grid>
        </Grid>
    </Border>
</Window>